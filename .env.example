# GEMINI_API_KEY: Required for Gemini AI API calls (server only, never in client bundle).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: fast Flash model used for transaction parsing. Override without code changes.
GEMINI_MODEL="gemini-2.5-flash"

# PORT: Express server port.
PORT="3000"

# NODE_ENV: "production" serves dist/ statically; otherwise Vite middleware with HMR.
NODE_ENV="development"

# DISABLE_HMR: set to "true" to disable Vite HMR/file-watching (e.g. AI Studio agent edits).
DISABLE_HMR="false"

# APP_URL: The URL where this applet is hosted (injected by AI Studio at runtime).
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE_URL / SUPABASE_ANON_KEY: server + Functions verify the caller's JWT
# with supabase.auth.getUser(token). Set the same values in Netlify site
# settings (never commit real values). RLS keeps every user on their own rows.
SUPABASE_URL="https://xyzcompany.supabase.co"
SUPABASE_ANON_KEY="MY_SUPABASE_ANON_KEY"

# VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY: public client values baked into
# the bundle at build time. The anon key is PUBLIC and safe in the bundle;
# it is protected by RLS, not by secrecy.
VITE_SUPABASE_URL="https://xyzcompany.supabase.co"
VITE_SUPABASE_ANON_KEY="MY_SUPABASE_ANON_KEY"

# SUPABASE_SERVICE_ROLE_KEY: server only (never VITE_). Finds/creates the
# Supabase user behind a phone number and mints its session. Needed for the
# SMS login only.
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# --- SMS.ir (server only — never in the client bundle) ---
# SMSIR_API_KEY: web-service key from the SMS.ir panel. Rotate the key that
# was shared in plain text before using it in production.
SMSIR_API_KEY="YOUR_SMSIR_API_KEY"
# SMSIR_SENDER: sender line for /v1/send/bulk (e.g. 30004505000017). Optional
# when a template is configured (the first panel line is auto-detected).
SMSIR_SENDER=""
# SMSIR_TEMPLATE_ID: template id for /v1/send/verify. When set it wins over bulk.
SMSIR_TEMPLATE_ID=""
# SMSIR_CODE_PARAM: parameter name inside the template that carries the code.
SMSIR_CODE_PARAM="Code"
# SMSIR_BASE_URL: panel API root.
SMSIR_BASE_URL="https://api.sms.ir/v1"

# --- SMS login tuning (server only) ---
# SMS_OTP_SECRET: HMAC key for hashing the one-time codes. MUST be identical
# in every environment (Express + Netlify) and long/random.
SMS_OTP_SECRET="YOUR_RANDOM_OTP_SECRET"
SMS_OTP_TTL_SECONDS="300"
SMS_OTP_LENGTH="5"
SMS_OTP_MAX_ATTEMPTS="3"
SMS_OTP_RESEND_SECONDS="60"
SMS_OTP_MAX_PER_HOUR_PER_PHONE="5"
SMS_OTP_MAX_PER_HOUR_PER_IP="20"

# NEVER prefix secrets with VITE_: anything starting with VITE_ ships inside
# dist/ for everyone to read. GEMINI_API_KEY and SUPABASE_SERVICE_ROLE_KEY
# must stay server-side only (Netlify env, never VITE_).

# SECRETS_SCAN_OMIT_KEYS (Netlify site settings only, comma-separated names):
# Netlify's secrets scanner flags the public anon key inside the bundle.
# Allowlist ONLY "VITE_SUPABASE_ANON_KEY,SUPABASE_ANON_KEY" — never disable
# the whole scan, and never list GEMINI_API_KEY or service_role keys here.

# AI_DAILY_LIMIT lives in server/aiUsage.ts (default 200/user/day, table ai_usage).
