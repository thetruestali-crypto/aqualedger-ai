# GEMINI_API_KEY: Required for Gemini AI API calls (server only, never in client bundle).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: fast Flash model used for transaction parsing. Override without code changes.
GEMINI_MODEL="gemini-2.5-flash"

# PORT: Express server port.
PORT="3000"

# NODE_ENV: "production" serves dist/ statically; otherwise Vite middleware with HMR.
NODE_ENV="development"

# DISABLE_HMR: set to "true" to disable Vite HMR/file-watching (e.g. AI Studio agent edits).
DISABLE_HMR="false"

# APP_URL: The URL where this applet is hosted (injected by AI Studio at runtime).
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
